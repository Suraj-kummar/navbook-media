DATABASE_URL=postgresql://user:password@localhost:5432/navbook
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
BLOB_READ_WRITE_TOKEN=your-vercel-blob-rw-token

# Optional: Real email sending via Resend (https://resend.com — free 3000 emails/month)
# Leave blank to use console logging in dev mode
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@yourdomain.com

# App public URL (used in password reset links)
APP_URL=http://localhost:3000
